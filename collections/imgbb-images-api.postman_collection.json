              "urlencoded": [
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) API key for authentication."
                },
                {
                  "disabled": false,
                  "key": "image",
                  "value": "<string>",
                  "description": "(Required) A binary file, base64-encoded image data, or a remote image URL. Maximum 32 MB.\n"
                },
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "Optional file name. Auto-detected for binary multipart uploads."
                },
                {
                  "disabled": false,
                  "key": "expiration",
                  "value": "<integer>",
                  "description": "Auto-delete the image after this many seconds (60 to 15552000). Omit for permanent storage.\n"
