{
  "info": {
    "_postman_id": "ca2a39b5-f8c1-4df2-a587-2d47ac6c54c8",
    "name": "ImgBB Image Upload Images API",
    "description": "REST API (v1) for uploading images to ImgBB. Accepts binary files, base64-encoded image data, or image URLs via POST or GET. Returns JSON with direct image URL, viewer URL, thumbnail URL, delete URL, image dimensions, file size, MIME type, and optional expiration timestamp. Authentication is via an API key passed as the key query parameter or form field.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-21T20:41:42.000Z",
    "updatedAt": "2026-10-21T20:41:42.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-ca2a39b5-f8c1-4df2-a587-2d47ac6c54c8"
  },
